# Parallel Dify stack (no conflict with existing installation)
# Usage:
#   docker compose --env-file .env.parallel -f docker-compose.yaml -f docker-compose.parallel.yaml up -d

# Keep startup scope limited to common services only.
COMPOSE_PROFILES=postgresql,weaviate

# Public entry ports for NEW stack
EXPOSE_NGINX_PORT=8082
EXPOSE_NGINX_SSL_PORT=8445

# Internal nginx container ports (leave default)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Optional plugin debug port (host side)
EXPOSE_PLUGIN_DEBUGGING_PORT=5005

# New database naming (inside the new stack)
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify_new
DB_PLUGIN_DATABASE=dify_plugin_new
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# New redis settings (inside the new stack)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0

# Security keys (must be unique vs old installation)
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY
INIT_PASSWORD=
SANDBOX_API_KEY=CHANGE_ME_SANDBOX_API_KEY
PLUGIN_DAEMON_KEY=CHANGE_ME_PLUGIN_DAEMON_KEY
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME_PLUGIN_INNER_API_KEY

# URLs for NEW stack (replace with your new domain if needed)
CONSOLE_API_URL=http://localhost:8082/console/api
SERVICE_API_URL=http://localhost:8082/api
APP_API_URL=http://localhost:8082/api
APP_WEB_URL=http://localhost:8082
FILES_URL=http://localhost:8082/files

# Optional if you run HTTPS on this new stack
# NGINX_HTTPS_ENABLED=true
# CONSOLE_API_URL=https://new-dify.example.com/console/api
# SERVICE_API_URL=https://new-dify.example.com/api
# APP_API_URL=https://new-dify.example.com/api
# APP_WEB_URL=https://new-dify.example.com
# FILES_URL=https://new-dify.example.com/files
